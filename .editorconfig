; https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
ij_any_line_comment_at_first_column = false
ij_any_block_comment_at_first_column = false

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

[{*.just,*.justfile}]
indent_size = 4

[*.py]
indent_size = 4
