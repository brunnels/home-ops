{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>brunnels/home-ops//.renovate/autoMerge.json5",
    "github>brunnels/home-ops//.renovate/changelogs.json5",
    "github>brunnels/home-ops//.renovate/customManagers.json5",
    "github>brunnels/home-ops//.renovate/groups.json5",
    "github>brunnels/home-ops//.renovate/overrides.json5",
    ":timezone(America/Chicago)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    // Grouping rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
